// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole      @default(ADMIN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
}

model AuthSession {
  id           String   @id @db.Char(64)
  userId       Int
  createdAt    DateTime
  expiresAt    DateTime
  lastActiveAt DateTime
  mfa          String?  @db.VarChar(16)
  metadata     Json?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(160)
  categoryId  Int
  sku         String   @unique @db.VarChar(64)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  promotions  ProductPromotion[]

  @@index([categoryId])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(96)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active, name])
}

model Promotion {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(160)
  campaignType    CampaignType
  targetType      PromotionTarget
  targetValue     String?          @db.VarChar(160)
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  products        ProductPromotion[]

  @@index([active, startsAt, endsAt])
  @@index([targetType, targetValue])
}

model ProductPromotion {
  productId   Int
  promotionId Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([productId, promotionId])
  @@index([promotionId])
}

enum CampaignType {
  SELECTED_PRODUCTS
  CATEGORY
  MONTHLY
  EVENT
}

enum PromotionTarget {
  PRODUCTS
  CATEGORY
  STOREWIDE
}

enum UserRole {
  CUSTOMER
  ADMIN
}
