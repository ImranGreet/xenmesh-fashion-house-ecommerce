// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole      @default(ADMIN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
}

model StoreSettings {
  id           String   @id @default("store") @db.VarChar(24)
  storeName    String   @db.VarChar(160)
  contactEmail String   @db.VarChar(254)
  phone        String   @db.VarChar(32)
  location     String   @db.VarChar(160)
  updatedAt    DateTime @updatedAt
}

model AuthSession {
  id           String   @id @db.Char(64)
  userId       Int
  createdAt    DateTime
  expiresAt    DateTime
  lastActiveAt DateTime
  mfa          String?  @db.VarChar(16)
  metadata     Json?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(160)
  categoryId  Int
  sku         String   @unique @db.VarChar(64)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  promotions  ProductPromotion[]

  @@index([categoryId])
}

model Order {
  id            Int         @id @default(autoincrement())
  number        String      @unique @db.VarChar(40)
  customerName  String      @db.VarChar(160)
  phone         String      @db.VarChar(32)
  email         String?     @db.VarChar(254)
  address       String      @db.VarChar(500)
  city          String?     @db.VarChar(100)
  notes         String?     @db.VarChar(1000)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  status        OrderStatus @default(NEW)
  subtotal      Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([status, createdAt])
  @@index([phone])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productId  Int
  name       String   @db.VarChar(160)
  sku        String   @db.VarChar(64)
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
  lineTotal  Decimal  @db.Decimal(10, 2)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(96)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active, name])
}

model Promotion {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(160)
  campaignType    CampaignType
  targetType      PromotionTarget
  targetValue     String?          @db.VarChar(160)
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  products        ProductPromotion[]

  @@index([active, startsAt, endsAt])
  @@index([targetType, targetValue])
}

model ProductPromotion {
  productId   Int
  promotionId Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([productId, promotionId])
  @@index([promotionId])
}

enum CampaignType {
  SELECTED_PRODUCTS
  CATEGORY
  MONTHLY
  EVENT
}

enum PromotionTarget {
  PRODUCTS
  CATEGORY
  STOREWIDE
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}
